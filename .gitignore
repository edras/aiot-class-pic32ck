# VSCode - ignore user-specific files, keep project configs
.vscode/c_cpp_properties.json
.vscode/*.log

# MPLabX ignore files
.generated_files
dist/
debug/
build/
private/
node_modules/
**/nbproject/Makefile-*
**/nbproject/Package-*
defmplabxtrace*
queuelogs/
overlay-content/

# MPLabX don't ignore harmony files
!**/system/debug

## node-red ignore files

# Dependency directory
node_modules

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# OSX
.DS_Store

